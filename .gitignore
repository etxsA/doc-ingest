# Environments, tool caches and OS files (any folder)
.venv/
.bench-venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.hf/
.DS_Store
.claude/

# Local data, reproducible from scripts/fetch_samples.sh and the pipeline (any depth, so
# copies left at the old top-level paths stay ignored too); version with DVC if needed.
**/data/raw/
**/data/normalized/
**/data/bench/
**/data/samples/*.pdf
**/data/samples/*.html
**/data/samples/*.png
**/data/samples/*.truth.json
!**/data/samples/.gitkeep

# Local-only: the generated technical report and its builder, never published (any depth,
# so they stay ignored at the old top-level paths and inside packages/docingest/)
**/docingest_report.pdf
**/docingest_overview.pdf
**/docs/report/
**/scripts/build_report.py
