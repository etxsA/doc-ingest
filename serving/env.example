# Copy to serving/env.local (ignored by git) and fill in what differs on your machine; every line is optional.

# Where pid files and logs go, and the caches vLLM, Triton and torch.compile write.
# SERVING_STATE_DIR=$HOME/.local/state/research-engine
# SERVING_CACHE_DIR=$HOME/.cache/research-engine

# The vLLM install: a Python that can import vllm, or an existing vLLM environment reused through PYTHONPATH.
# VLLM_PYTHON=/path/to/python3.12          # needs the Python headers (Triton compiles kernels at start-up)
# VLLM_SITE_PACKAGES=/path/to/venv/lib/python3.12/site-packages
# VLLM_BIN=/path/to/venv/bin/vllm          # run with VLLM_PYTHON; without it, `vllm` must be on PATH
# SERVING_EXTRA_PATH=/path/with/ninja      # extra PATH entries (for example a folder that holds `ninja`)

# Models: downloaded into the Hugging Face cache by repository and pinned revision (models.tsv). To use a snapshot
# that already exists somewhere else, point the role at it (the revision is then the one of that folder).
# HF_HOME=/big/disk/huggingface
# HF_HUB_OFFLINE=1                         # never contact the Hub once the models are present
# LLM_MODEL_PATH=/path/to/models--cyankiwi--Qwen3.8-27B-AWQ-INT4/snapshots/<revision>
# EMBED_MODEL_PATH=...
# RERANK_MODEL_PATH=...

# Server sizes (fractions of one GPU; the embedder and the reranker fit together on one 48 GB card at 0.45 each).
# LLM_GPU_MEM=0.9      LLM_MAX_LEN=16384    LLM_EAGER=0
# EMBED_GPU_MEM=0.45   EMBED_MAX_LEN=8192
# RERANK_GPU_MEM=0.45  RERANK_MAX_LEN=8192
